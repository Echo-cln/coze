# Coze 工作流对接配置
# 复制此文件为 .env.local 并填入真实值

# ===== Coze 平台工作流（默认方式） =====
# Coze API 认证 Token（PAT/SAT）
# 获取方式：扣子平台 → 个人中心 → API Token → 新建 Token
COZE_WORKLOAD_API_TOKEN=

# 主编排工作流 ID (WF00_Report_Orchestrator)
# 在工作流编辑器 URL 中获取，例如 https://www.coze.cn/workflow/xxxxxx
COZE_WORKFLOW_ID=

# Coze API Base URL（默认国内站，国际站填 https://api.coze.com）
COZE_API_BASE_URL=https://api.coze.cn

# 工作空间 ID（列出工作流时需要，可选）
COZE_PROJECT_SPACE_ID=

# 自定义额外请求头（调试用，格式：key1=val1;key2=val2）
# COZE_EXTRA_HEADERS=

# ===== 独立部署的 WF10 工作流（FastAPI + LangGraph） =====
# 如果 WF10_Ingest_Parse 作为独立服务部署，填入其基础地址
# 示例：http://localhost:5000 或 https://wf10.example.com
# 留空则使用 Mock 模式或回退到 Coze 平台工作流
WF10_BASE_URL=
WF10_API_TOKEN=

# ===== 独立部署的 C 模块（证据抽取与冲突检测） =====
# C 模块：事实抽取、归一化去重与冲突识别；端口由部署环境决定
# 三个数据入口三选一：files(文件URL) / parsed_chunks(直通切片) / kb_query(知识库检索)
# 示例：http://localhost:9000
# 留空则使用 Mock 模式
C_MODULE_BASE_URL=
C_MODULE_API_TOKEN=

# C 模块所需知识库配置（kb_backend=coze_openapi 时使用）
# 队员B生成的 PAT（需 knowledge 权限）
KB_COZE_API_TOKEN=
KB_COZE_API_BASE_URL=https://api.coze.cn

# ===== 独立部署的 WF40 / WF50 / WF60 工作流 =====
# WF40_Outline_Write：大纲与章节写作（输入证据台账，输出版块草稿）
WF40_BASE_URL=
# WF50_Citation_QA：引用渲染与质量闸门（输入sections+evidence，输出渲染后结果）
WF50_BASE_URL=
# WF60_Render_Export：四页签专业渲染与导出（输入sections+evidence+conflicts）
WF60_BASE_URL=
WF60_API_TOKEN=

# ===== 对象存储（文件上传给工作流时使用） =====
# WF10 / C模块 需要通过 URL 访问文件，因此前端上传的文件需先存到对象存储
# 留空则解析阶段不传文件（仅 URL 来源可用）
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=

